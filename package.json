    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "node": "^26.3.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-to-print": "^3.3.0",
    "shadcn": "^4.7.0",
