SUI_NETWORK=testnet
SUI_RPC_URL=
SPLASH_PACKAGE_ID=
SPLASH_TREASURY_ID=
USDC_TYPE=0x2::sui::SUI
USDT_TYPE=
USDT_BUFFER_ID=
MIN_USDC_FLOAT_MICRO=100000000
TREASURY_ADDRESS=
ENOKI_API_KEY=
OPERATOR_SUI_ADDRESS=
# Server-side funded ED25519 suiprivkey. Never expose to the browser.
OPERATOR_SUI_PRIVATE_KEY=
# Use live for real testnet settlement after the signer is configured.
SUI_SETTLEMENT_MODE=auto

HATA_SC_API_KEY=
HATA_SC_API_SECRET=
HATA_SC_BASE_URL=https://api.hata.io/v1/my
HATA_LABUAN_API_KEY=
HATA_LABUAN_API_SECRET=
HATA_LABUAN_BASE_URL=https://api.hata.io/v1/global
HATA_TIER2_MIN_MYR=5000
HATA_OTC_MIN_MYR=200000
PHP_PER_USDC=56.5

# Fallback only — per-corridor fees come from lib/fx/corridors.ts and are
# passed to settlement.move as fee_bps. Capped at MAX_FEE_BPS = 200 on-chain.
PLATFORM_FEE_BPS=80
FIXED_FEE_SEN=450
QUOTE_TTL_SECONDS=30
DEFAULT_KYC_TIER=1
USDC_AVAILABLE_MICRO=1000000000000000
USDT_AVAILABLE_MICRO=0
USDT_BUFFER_AGE_MS=0
USE_MOCK_APIS=false

SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=
SUMSUB_BASE_URL=https://api.sumsub.com

ADMIN_EMAIL=staff@splash.finance
